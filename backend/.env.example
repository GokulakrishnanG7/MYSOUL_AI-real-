# MySoul AI development settings
APP_ENV=development
APP_SECRET_KEY=replace-this-in-development
CORS_ORIGINS=http://localhost:8000,http://localhost:5500,http://127.0.0.1:8000
DATABASE_URL=sqlite:///./data/mysoul.db

# Optional LLM provider. The backend falls back gracefully when unset.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Console is the safe default for the SOS family-alert adapter.
ALERT_PROVIDER=console
